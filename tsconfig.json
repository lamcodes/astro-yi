{
  "extends": "astro/tsconfigs/base",
  "compilerOptions": {
    "strict": false,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "checkJs": false,
    "paths": {
      "src/*": [
        "./src/*"
      ],
      "$components": [
        "./src/components"
      ],
      "$": [
        "./src"
      ]
    },
    "types": [
      "astro/env",
      "vitest/globals"
    ],
    "jsxImportSource": "solid-js",
    "noErrorTruncation": true
  },
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "tests/**/*.ts"
  ],
  "exclude": [
    "dist"
  ]
}
