---
import {formatDate} from "../utils/formatDate";
import {dealLabel} from "../utils/dealLabel";
import {t} from '../i18n/utils'
const {title, date, slug, category, tags, sticky = false, draft = false} = Astro.props
---

<div class="post-card-content">
  <!-- title -->
  <div class="post-title-row">
    {sticky > 0 &&
      <div class="post-sticky">{t('home.sticky')}</div>}
    <a class="post-title-link" href={slug}>
      {title}
    </a>
  </div>

  <!-- meta info: pill 样式 -->
  <div class="post-meta">
    <!-- date -->
    {
      date && (
        <span class="meta-pill meta-pill-date">
          <i class="ri-calendar-2-fill"/>
          {formatDate(date)}
        </span>
      )
    }

    <!-- draft -->
    {
      draft &&
      <span class="meta-pill meta-pill-draft">
        <i class="ri-git-pr-draft-line"/>
        {t('title.draft')}
      </span>
    }

    <!-- category -->
    {
      category && dealLabel(category).filter(item => item !== 'uncategorized').map((categoryName) => (
        <a class="meta-pill meta-pill-category" href={"/category/" + categoryName}>
          <i class="ri-folder-3-line"/>
          {categoryName}
        </a>
      ))
    }

    <!-- tag -->
    {
      tags && dealLabel(tags).map((tagName) => (
        <a class="meta-pill meta-pill-tag" href={"/tags/" + tagName}>
          <i class="ri-price-tag-3-line"/>
          {tagName}
        </a>
      ))
    }
  </div>
</div>
