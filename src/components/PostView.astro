---
import { getBlogPath } from '../utils/content-entry'
import PostViewTitle from '../components/PostViewTitle.astro'
const {blog} = Astro.props;
const {data, id} = blog
---

<!-- 文章卡片容器：卡片化设计，增加 hover 效果 -->
<div class="post-card">
  <PostViewTitle
    slug={getBlogPath(id)}
    {...data}
  >
  </PostViewTitle>
  <p class="post-description">
    {
      data.description ? data.description : ''
    }
  </p>
</div>
