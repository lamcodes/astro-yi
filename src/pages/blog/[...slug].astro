---
import { getCollection, getEntry, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro'
import PostTitle from "../../components/PostTitle.astro";
import BlogFooter from '../../components/BlogFooter.astro'
import { getBlogPath, shouldIncludeEntry } from '../../utils/content-entry';
import {getCollectionByName} from "../../utils/getCollectionByName";
import {sortPostsByDate} from "../../utils/sortPostsByDate";
import Donate from '../../components/Donate.astro'
import {donate, site} from "../../consts";

export async function getStaticPaths() {
  const blogEntries = (await getCollection('blog')).filter(({data}) => {
    return shouldIncludeEntry(data, import.meta.env.PROD)
  });
  return blogEntries.map(entry => ({
    params: {slug: entry.id},
  }));
}

const slug = Astro.params.slug;
const entry = slug ? await getEntry('blog', slug) : undefined;

if (!entry) {
  throw new Error(`Missing blog entry for slug: ${slug}`)
}

const {Content, remarkPluginFrontmatter} = await render(entry);

const lastModified = remarkPluginFrontmatter.lastModified
const readingTime = remarkPluginFrontmatter.readingTime
const canonicalUrl = new URL(getBlogPath(entry.id), Astro.site).href

const posts = await getCollectionByName("blog");
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: entry.data.title,
  description: entry.data.description || site.description,
  author: {
    '@type': 'Person',
    name: site.author,
  },
  publisher: {
    '@type': 'Person',
    name: site.author,
  },
  datePublished: entry.data.date.toISOString(),
  dateModified: new Date(lastModified || entry.data.date).toISOString(),
  mainEntityOfPage: canonicalUrl,
  url: canonicalUrl,
}
const sortPosts = sortPostsByDate(posts);

const currentPostIndex = sortPosts.findIndex(
  (postItem) => postItem.data.title === entry.data.title
);
let prevPost, nextPost
if (sortPosts[currentPostIndex - 1]) {
  prevPost = sortPosts[currentPostIndex - 1];
}
if (sortPosts[currentPostIndex + 1]) {
  nextPost = sortPosts[currentPostIndex + 1];
}
---
<BlogPost
  frontmatter={entry.data}
  structuredData={structuredData}
  prevUrl={prevPost ? getBlogPath(prevPost.id) : undefined}
  nextUrl={nextPost ? getBlogPath(nextPost.id) : undefined}
>
  <div>
    <PostTitle slug={getBlogPath(entry.id)} {...entry.data} lastModified={lastModified} readingTime={readingTime}></PostTitle>
    <div class="divider-horizontal"></div>
    <article class="markdown-body">
      <Content/>
    </article>
    <div class="divider-horizontal"></div>
    <div class="h-8 text-skin-base">
      {
        prevPost ? (
          <a
            class="truncate  w-auto max-w-[40%] float-left"
            href={getBlogPath(prevPost.id)}
            title={prevPost.data.title}
          >
            <i class="ri-arrow-left-s-fill"/>
            {prevPost.data.title}
          </a>
        ) : (
          <div/>
        )
      }
      {
        nextPost ? (
          <div class="flex item-center float-right w-auto max-w-[40%] text-right">
            <a class="truncate " href={getBlogPath(nextPost.id)} title={nextPost.data.title}>
              {nextPost.data.title}
            </a>
            <i class="ri-arrow-right-s-fill float-right"/>
          </div>
        ) : (
          <div/>
        )
      }
    </div>
    <BlogFooter title={entry.data.title} url={getBlogPath(entry.id)} date={entry.data.date}></BlogFooter>
    {
      donate.enable && entry.data.donate &&
      <Donate></Donate>
    }
  </div>

</BlogPost>
