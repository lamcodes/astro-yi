---
import IndexPage from "src/layouts/IndexPage.astro";
import {Search} from '../components/Search'
import {getCollectionByName} from "../utils/getCollectionByName";
import {site} from "../consts";
const posts = await getCollectionByName("blog");
import {t} from '../i18n/utils'
---

<IndexPage frontmatter={{ title: `搜索 | ${site.title}`, description: `在 ${site.title} 中搜索文章。`, robots: 'noindex, follow' }}>
  <div class="text-2xl mb-4 text-skin-base">{t('search.search')}</div>
  <Search client:only="solid-js" posts={posts}/>
</IndexPage>
