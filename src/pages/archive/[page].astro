---
import IndexPage from "src/layouts/IndexPage.astro";
import Pagination from "src/components/Pagination.astro";
import { sortPostsByDate } from "src/utils/sortPostsByDate";
import getPostsByYear from "src/utils/getPostsByYear";
import  {site} from "../../consts";
import dayjs from "dayjs";
import { getCollectionByName } from "../../utils/getCollectionByName";
import { getBlogPath } from "../../utils/content-entry";

export async function getStaticPaths({ paginate }) {
  let posts = await getCollectionByName("blog");
  posts = sortPostsByDate(posts);
  return paginate(posts, { pageSize: site.archivePageSize });
}

interface PageProps {
  data: any[];
  currentPage: number;
  lastPage: number;
  url: {current: string, prev?: string, next?: string};
}

const { page } = Astro.props as { page: PageProps };
let resultPosts = getPostsByYear(page.data);
const pageTitle = page.currentPage === 1 ? `归档 | ${site.title}` : `归档 - 第 ${page.currentPage} 页 | ${site.title}`
const pageDescription = `浏览 ${site.title} 的所有文章归档。`
---

<IndexPage frontmatter={{ title: pageTitle, description: pageDescription, prevUrl: page.url.prev, nextUrl: page.url.next }}>
  {
    Object.keys(resultPosts)
      .sort((a, b) => Number(b) - Number(a))
      .map((year) => (
        <div>
          <div class="text-2xl font-extrabold my-4">{year}</div>
          <ul>
            {resultPosts[year].map((post) => (
              <li style="list-style-type: disc;" class="ml-4 my-2">
                <a href={getBlogPath(post.id)}>
                  <span class="mr-4">
                    {dayjs(post.data.date).format("YYYY-MM-DD")}
                  </span>
                  <span class="hover:text-skin-active">
                  {post.data.title}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
  }
  <Pagination
    currentPage={page.currentPage}
    totalPage={page.lastPage}
    prefixUrl="/archive/"
    url={page.url}
  />
</IndexPage>
