---
import { getEntry, render } from 'astro:content'
import {sortPostsByDate} from "src/utils/sortPostsByDate";
import {getCollectionByName} from "../../utils/getCollectionByName";
import BlogPost from '../../layouts/BlogPost.astro'
import {comment} from "../../consts";
import {formatDate} from '../../utils/formatDate'
import {t} from '../../i18n/utils'
import { getFeedPath } from '../../utils/content-entry'

export async function getStaticPaths() {
  const posts = await getCollectionByName("feed");
  return posts.map((post) => ({
    params: {slug: post.id},
  }));
}

const slug = Astro.params.slug;
const post = slug ? await getEntry('feed', slug) : undefined;

if (!post) {
  throw new Error(`Missing feed entry for slug: ${slug}`)
}

const {Content} = await render(post);
const posts = await getCollectionByName("feed");
const sortPosts = sortPostsByDate(posts);

const postDate = post.data.date ? formatDate(post.data.date) : '';

// 使用时间戳比较日期，避免 Date 对象引用问题
const currentPostIndex = sortPosts.findIndex(
  (postItem) => postItem.data.date && post.data.date &&
    new Date(postItem.data.date).getTime() === new Date(post.data.date).getTime()
);
let prevPost: any, nextPost: any;
if (currentPostIndex !== -1) {
  if (sortPosts[currentPostIndex - 1]) {
    prevPost = sortPosts[currentPostIndex - 1];
  }
  if (sortPosts[currentPostIndex + 1]) {
    nextPost = sortPosts[currentPostIndex + 1];
  }
}
---

<BlogPost
  frontmatter={post.data}
  prevUrl={prevPost ? getFeedPath(prevPost.id) : undefined}
  nextUrl={nextPost ? getFeedPath(nextPost.id) : undefined}
  backUrl="/feed/1"
>
  {
    (
      <div class="flex items-center mb-2">
        {postDate &&
          <div class="flex items-center">
            <i class="ri-calendar-2-fill mr-1"/>
            <div class="tag">{postDate}</div>
          </div>}
        {comment.enable && comment.type === "waline" && comment.walineConfig.pageview && (
          <div class="divider-vertical"/>
          <a href="#" title="当前页面阅读量" class="flex items-center">
            <i class="ri-fire-fill mr-1"/>
            <span class="waline-pageview-count" data-path={getFeedPath(post.id)}/>
          </a>
          <div class="divider-vertical"/>
          <a href="#waline" title="当前页面评论数" class="flex items-center">
            <i class="ri-discuss-fill mr-1"/>
            <span class="waline-comment-count" data-path={getFeedPath(post.id)}/>
          </a>
        )}
      </div>
    )
  }
  <div class="divider-horizontal"></div>
  <article class="markdown-body scroll-smooth mb-4">
    <Content/>
  </article>
  <div class="divider-horizontal"></div>
  {
    (
      <div>
        {prevPost ? (
          <a
            class="truncate  w-auto max-w-[40%] float-left"
              href={getFeedPath(prevPost.id)}
            title={prevPost.data.title}
          >
            <i class="ri-arrow-left-s-fill"/>
            {t('feed.previous')}
          </a>
        ) : (
          <div/>
        )}
        {nextPost ? (
          <div class="flex item-center float-right w-auto max-w-[40%] text-right">
            <a
              class="truncate "
              href={getFeedPath(nextPost.id)}
              title={nextPost.data.title}
            >
              {t('feed.next')}
            </a>
            <i class="ri-arrow-right-s-fill float-right"/>
          </div>
        ) : (
          <div/>
        )}
      </div>
    )
  }
  <div class="h-4"></div>
</BlogPost>
